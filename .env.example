# PyMem Environment Variables

# Platform
PYMEM_MASTER_KEY=sk-pymem-change-me
PYMEM_ENV=dev
PYMEM_VERSION=1.0.0

# Primary relational store
DATABASE_URL=postgresql+asyncpg://pymem:pymem@localhost:5432/pymem

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_WORKING_MEMORY_DB=1
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3

# Vector store
VECTOR_STORE_BACKEND=pgvector
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=pymem

# Graph store
GRAPH_STORE_BACKEND=kuzu
KUZU_DB_PATH=./data/kuzu
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Embeddings
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# PyGate (LLM routing)
PYGATE_URL=http://localhost:4000
PYGATE_API_KEY=sk-pygate-change-me
EXTRACTION_MODEL=gpt-4o-mini
CONSOLIDATION_MODEL=gpt-4o-mini
SCORING_MODEL=gpt-4o-mini

# Memory defaults
WORKING_MEMORY_TTL_SECONDS=3600
WORKING_MEMORY_MAX_TOKENS=8000
EPISODIC_MEMORY_TTL_DAYS=90
SEMANTIC_MEMORY_DECAY_DAYS=365
DEFAULT_SEARCH_LIMIT=10
MAX_SEARCH_LIMIT=100

# Extraction
EXTRACTION_ASYNC=true
EXTRACTION_BATCH_SIZE=10
MIN_MEMORY_SCORE=0.3

# Multi-tenancy
DEFAULT_ORG_MEMORY_LIMIT=100000
DEFAULT_USER_MEMORY_LIMIT=10000

# Observability
LOG_LEVEL=INFO
PROMETHEUS_ENABLED=true
OTEL_ENDPOINT=

# Postgres password (for docker-compose)
POSTGRES_PASSWORD=pymem
